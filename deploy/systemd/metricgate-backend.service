[Unit]
Description=MetricGate Laravel backend via artisan serve
After=network.target mysql.service

[Service]
Type=simple
User=server
WorkingDirectory=/var/www/proyectometricgate/backendApi
ExecStart=/usr/bin/php artisan serve --host=127.0.0.1 --port=8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target